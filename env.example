# Sisho 環境変数サンプル。写して .env にし、値を入れる（.env は .gitignore 済み）。
# 読み込みは src/db_config.py（依存ライブラリなしの簡易パーサ・既存の環境変数を優先）。

# PostgreSQL 接続
DB_HOST=localhost
DB_PORT=5435
DB_NAME=rag_dev
DB_USER=devuser
DB_PASSWORD=your_db_password_here
# スタンバイ（任意・重い更新中に読み先を切り替える用。無ければ同じ値でよい）
DB_PORT_STANDBY=5436

# MCP サーバー（HTTP 常駐のとき）
# 待ち受けパス。公開する場合は推測されにくい値にする（deploy/mtg-rag-mcp.service が EnvironmentFile で読む）
MCP_HTTP_PATH=/mcp
# 道具の呼び出し履歴の書き先（省略時は作者環境の既定パス）
# MCP_TOOL_LOG=/path/to/logs/mcp_tools.log

# 搬入便の入力ファイル（省略時は作者環境の既定パス）
# MTG_ORACLE_JSON=/path/to/oracle_cards.json
# MTG_ALL_CARDS_JSON=/path/to/all_cards_scryfall.json
