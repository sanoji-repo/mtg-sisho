# Sisho 環境変数サンプル。写して .env にし、値を入れる（.env は .gitignore 済み）。
# 読み込みは src/db_config.py（依存ライブラリなしの簡易パーサ・既存の環境変数を優先）。

# PostgreSQL 接続
DB_HOST=localhost
DB_PORT=5435
DB_NAME=rag_dev
DB_USER=devuser
DB_PASSWORD=your_db_password_here
# スタンバイ（任意・重い更新中に読み先を切り替える用。無ければ同じ値でよい）
DB_PORT_STANDBY=5436

# MCP サーバー（HTTP 常駐のとき）
# 旧パス（互換のため残す・MCP_LEGACY_PATH=0 で閉じる）。新しい入口は発行ページ /issue と /mcp/<札>
MCP_HTTP_PATH=/mcp
# 道具の呼び出し履歴の書き先（省略時は作者環境の既定パス）
# MCP_TOOL_LOG=/path/to/logs/mcp_tools.log

# 門と札（小片 8）
# 札の台帳 TSV（省略時はリポジトリ直下の state/fuda.tsv。公開サーバーでは必ず設定＝箱は ProtectSystem=strict のため /var/log/mtg-sisho/fuda.tsv）
# MCP_FUDA_FILE=/var/log/mtg-sisho/fuda.tsv
# 札付き接続 URL のパス接頭辞（既定: /mcp/）
MCP_FUDA_PREFIX=/mcp/
# 札ごとの 1 分間あたりの呼び出し枠（既定: 60）
MCP_FUDA_PER_MIN=60
# 発行元 IP ごとの 1 日あたりの最大発行数（既定: 3）
MCP_ISSUE_PER_DAY=3
# サーバー全体の 1 日あたりの最大発行総数（既定: 100）
MCP_ISSUE_GLOBAL_DAY=100
# 旧パスの有効化フラグ（1 で有効、0 で旧パスを閉じる。既定: 1）
MCP_LEGACY_PATH=1
# 発行ページが表示する接続 URL の基底 URL（空なら Host ヘッダから組む。公開サーバーでは必ず設定。例: https://sisho.tailf8ef32.ts.net）
# MCP_PUBLIC_BASE=https://sisho.tailf8ef32.ts.net
# 接続 URL 発行ページのパス（既定: /issue）
MCP_ISSUE_PATH=/issue
# 外部 API（Commander Spellbook）を守るための札ごとの 1 分間あたりの枠（既定: 10）
MCP_COMBOS_PER_MIN=10
# Commander Spellbook 照会の全体の 1 分間あたりの枠（既定: 60）
MCP_COMBOS_GLOBAL_MIN=60

# 搬入便の入力ファイル（省略時は作者環境の既定パス）
# MTG_ORACLE_JSON=/path/to/oracle_cards.json
# MTG_ALL_CARDS_JSON=/path/to/all_cards_scryfall.json

