# mtg-rag-mcp.service — MCP サーバ（streamable-http :8765）の systemd user unit
# =========================================================================
# 置き場所: ~/.config/systemd/user/mtg-rag-mcp.service（サーバーを動かすユーザー）
# 前提:     sudo loginctl enable-linger <ユーザー> 済み（ログイン無しでも起動する）
#           下の /path/to/mtg_sisho（リポジトリの場所）と /path/to/python（mcp SDK と psycopg2 が
#           import できる Python）を自分の環境に合わせて書き換えてから置く。
#
# インストール（そのユーザーの権限のみで可・sudo 不要）:
#   cp deploy/mtg-rag-mcp.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now mtg-rag-mcp
# 操作:
#   systemctl --user status|restart|stop mtg-rag-mcp
#   journalctl --user -u mtg-rag-mcp -f      ← ログ追尾
#
# 注意 1: mcp SDK を venv の外に入れている場合は、その場所を PYTHONPATH に足す。
#         import できないと ModuleNotFoundError: No module named 'mcp' で即死する。
# 注意 2: ルーター・絞り込みゲート・スコア補正部品を全廃したので全道具が DB 直結に
#         なった＝mtg-rag-api(:8000) への依存は撤去済み。待つのは PostgreSQL(5435) だけ。
# 注意 3: stdio 版（Claude Code 用）は別経路で、この unit とは無関係に
#         クライアント側が都度起動する。ここで面倒を見るのは HTTP 版だけ。

[Unit]
Description=MTG RAG MCP server (streamable-http on 127.0.0.1:8765)

[Service]
Type=simple
WorkingDirectory=/path/to/mtg_sisho
# 秘密の待ち受けパス MCP_HTTP_PATH（無ければ /mcp のまま）
EnvironmentFile=-%h/.config/mtg-rag/mcp.env
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -f /path/to/mtg_sisho/src/mcp_server.py ] && (echo > /dev/tcp/127.0.0.1/5435) 2>/dev/null && exit 0; sleep 2; done; echo "[mtg-rag-mcp] deps not ready (mount/db)"; exit 1'
ExecStart=/path/to/python /path/to/mtg_sisho/src/mcp_server.py http 8765
Restart=on-failure
RestartSec=5
# 注意 5: uvicorn は停止時に「接続が閉じるまで待つ」。ブラウザ Claude のコネクタは
#         セッションを掴んだままなので、これが無いと restart が永遠に終わらない
#         （実際に deactivating で固まった）。猶予後に強制終了させる。
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=default.target
